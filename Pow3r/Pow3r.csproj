<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- Veldrid 4.8.0 still pulls SharpDX/D3D11 transitively, which triggers
             legacy netcore vulnerability advisories in this dev-only tool. -->
        <!-- Libuv's legacy RID assets produce NETSDK1206 in .NET 10, but Pow3r does not ship or consume those distro-specific assets. -->
        <NoWarn>$(NoWarn);NU1903;NETSDK1206</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ImGui.NET" />
      <PackageReference Include="OpenTK.Graphics" />
      <PackageReference Include="OpenTK.Mathematics" />
      <PackageReference Include="OpenTK.Windowing.Desktop" />
      <PackageReference Include="Veldrid" />
      <PackageReference Include="Veldrid.SPIRV" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Content.Server\Content.Server.csproj" />
    </ItemGroup>

  <Import Project="..\RobustToolbox\Imports\Shared.props" />
  <Import Project="..\RobustToolbox\MSBuild\Robust.Properties.targets" />
</Project>



