station-traits-report-title = [bolditalic]Nanotrasen Department of Intelligence Threat Advisory, Sol Sector, TCD {$date}:[/bolditalic]
station-traits-report-advisory = Advisory Level: [bold]Yellow Star[/bold]
    {"   "}Your sector's advisory level is Yellow Star.
    {"   "}Surveillance shows a credible risk of enemy attack against our assets in the Sol Sector.
    {"   "}We advise a heightened level of security alongside maintaining vigilance against potential threats.
station-traits-report-header = [bold]Identified shift divergencies:[/bold]
station-traits-report-footer = [italic]This advisory is intended for the staff of {$station}. If this is not your station, you must destroy this document immediately.[/italic]
station-traits-report-announcement = A summary of the station's situation has been copied and printed to all communications consoles.
station-traits-report-sender = Station Report

station-event-carp-migration-announcement = Unknown biological entities have been detected near the station, please stand by.
station-event-carp-migration-sender = Lifesign Alert

station-traits-report-date-format = ddd, MMM dd, yyyy

cmd-forcestationtrait-desc = Forces a station trait to be picked when the next round starts, only for the next round
cmd-forcestationtrait-help = forcestationtrait <id>
cmd-forcestationtrait-hint = <station trait>
cmd-forcestationtrait-success = Trait {$id} will be forced for the next round
cmd-forcestationtrait-unknown = Unknown station trait ID '{$id}'

station-trait-anomaly-storm-name = Anomaly Storm
station-trait-anomaly-storm-report = Anomalous readings in your region are off the charts! Keep a few locators handy...

station-trait-blackout-name = Blackout
station-trait-blackout-report = Station lights seem to be damaged, be safe when starting your shift today.

station-trait-bot-languages-name = Bot Language Matrix Malfunction
station-trait-bot-languages-report = Your station's friendly bots have had their language matrix fried due to an ion storm, resulting in some strange and unfamiliar speech patterns.

station-trait-machine-languages-name = Machine Language Matrix Malfunction
station-trait-machine-languages-report = Your station's machines have had their language matrix fried due to an ion storm, resulting in some strange and unfamiliar speech patterns.

station-trait-carp-infestation-name = Carp infestation
station-trait-carp-infestation-report = Dangerous fauna is present in the area of this station.

station-trait-empty-maint-name = Cleared out maintenance
station-trait-empty-maint-report = Our workers cleaned out most of the junk in the maintenace areas.

station-trait-distant-supply-lines-name = Distant supply lines
station-trait-distant-supply-lines-report = Due to the distance to our normal supply lines, cargo orders are more expensive.

station-trait-ionic-stormfront-name = Ionic Stormfront
station-trait-ionic-stormfront-report = An ionic stormfront is passing over your station's system. Expect an increased likelihood of ion storms afflicting your station's silicon units.

station-trait-late-arrivals-name = Late Arrivals
station-trait-late-arrivals-report = Sorry for that, we didn't expect to fly into that vomiting goose while bringing you to your new station.

station-trait-meteor-swarm-name = Meteor Swarm
station-trait-meteor-swarm-report = The space around your station has an unusual number of asteroids orbiting your star.

station-trait-space-dust-name = Space Dust
station-trait-space-dust-report = Your station is passing through a cloud of cosmic dust. Expect reduced visibility outside the hull and avoid unnecessary spacewalks.

station-trait-random-spawns-name = Drive-by landing
station-trait-random-spawns-report = Sorry for that, we missed your station by a few miles, so we just launched you towards your station in pods. Hope you don't mind!

station-trait-overflow-job-mistake-name = Overflow bureaucracy mistake
station-trait-overflow-job-mistake-report = It seems for some reason we put out the wrong job-listing for the overflow role this shift...

station-trait-post-revolutionary-fervor-name = Post-Revolutionary Fervor
station-trait-post-revolutionary-fervor-report = Your station was recently reclaimed from a revolutionary commune. We couldn't clean up after them in time.

station-trait-bananium-shipment-name = Bananium Shipment
station-trait-bananium-shipment-report = Rumor has it that the clown planet has been sending support packages to clowns in this system.

station-trait-ian-adventure-name = Ian's Adventure

station-trait-unique-ai-name = Unique AI
station-trait-unique-ai-report = For experimental purposes, this station AI might show divergence from default lawset. Do not meddle with this experiment.

station-trait-triple-ai-name = AI Triumvirate
station-trait-triple-ai-report = Your station has been instated with three Nanotrasen Artificial Intelligence models.

station-trait-airlock-misconfiguration-name = Airlock Misconfiguration
station-trait-airlock-misconfiguration-report = The last crew seemed to have messed with some of the airlocks' access levels. Apologies to your Chief Engineer in advance.

station-trait-bountiful-bounties-name = Bountiful bounties
station-trait-bountiful-bounties-report = It seems collectors in this system are extra keen to on bounties, and will pay more to see their completion.

station-trait-filled-maint-name = Filled up maintenance
station-trait-filled-maint-report = Our workers accidentally forgot more of their personal belongings in the maintenace areas.

station-trait-free-scarves-name = Free scarves
station-trait-free-scarves-report = The station is definitely not under attack by neck grappling aliens masquerading as wool. Definitely not.

station-trait-galactic-grant-name = Galactic grant
station-trait-galactic-grant-report = Your station has been selected for a special grant. Some extra funds has been made available to your cargo department.

station-trait-lucky-winner-name = Lucky winner
station-trait-lucky-winner-report = Your station has won the grand prize of the annual station charity event. Free snacks will be delivered to the bar every now and then.

station-trait-strong-supply-lines-name = Strong supply lines
station-trait-strong-supply-lines-report = Prices are low in this system, BUY BUY BUY!

station-trait-evil-pun-pun-name = Perma prisoner
station-trait-evil-pun-pun-report = Pun Pun has been locked up in the brig for crimes against humanity. Do not let him escape, but try to keep him alive too.
