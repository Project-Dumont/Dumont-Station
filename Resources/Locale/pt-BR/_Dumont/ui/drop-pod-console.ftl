## Tradução droppod

drop-pod-console-title = Console de Implantação da Cápsula de Assalto

drop-pod-console-beacon-list-header = SELECIONE O LOCAL DE POUSO
drop-pod-console-selected-header = ALVO SELECIONADO

drop-pod-console-sector-none = Nenhum local selecionado.

drop-pod-console-deploy-button = LANÇAR CÁPSULA

drop-pod-console-status-ready = Status: Pronto para lançamento.
drop-pod-console-status-not-ready = Status: Sistema recarregando. Aguarde.
drop-pod-console-status-launched = Status: Cápsula já lançada.

drop-pod-console-tc-label = Telecristais: { $balance } / { $cost } TC
