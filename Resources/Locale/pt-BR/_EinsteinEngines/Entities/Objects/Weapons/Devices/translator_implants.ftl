ent-BubblishTranslatorImplant = { ent-BaseSubdermalImplant } tradutor borbulhês.
    .desc = Um implante que ajuda a falar e entender a língua dos slimes! Cordas vocais especiais não inclusas. Pop!

ent-NekomimeticTranslatorImplant = { ent-BaseSubdermalImplant } tradutor nekomimético
