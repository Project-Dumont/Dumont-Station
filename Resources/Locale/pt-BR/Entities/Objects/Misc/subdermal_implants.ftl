# Base
ent-BaseSubdermalImplant = implante
    .desc = Um biochip microscópico que é injetado por baixo da pele.

# Tripulação
# Diversão
ent-SadTromboneImplant = { ent-BaseSubdermalImplant } de { ent-SadTromboneImplanter.suffix }
    .desc = Um implante que toca uma música trágica quando o usuário morre.

ent-LightImplant = { ent-BaseSubdermalImplant } de { ent-LightImplanter.suffix }
    .desc = Um implante que emite uma luz da pele do usuário quando ativo.

ent-BikeHornImplant = { ent-BaseSubdermalImplant } de { ent-BikeHornImplanter.suffix }
    .desc = Um implante que permite ao usuário buzinar a qualquer momento e em qualquer lugar. Honk!

# Segurança
ent-TrackingImplant = { ent-BaseSubdermalImplant } { ent-TrackingImplanter.suffix }
    .desc = Um implante que possui um dispositivo rastreador conectado à rede de monitoramento da tripulação.

# Antagonistas
ent-StorageImplant = { ent-BaseSubdermalImplant } de { ent-StorageImplanter.suffix }
    .desc = Um implante que permite ao usuário livrar-se de algemas ou amarras até três vezes antes de parar de funcionar.

ent-FreedomImplant = { ent-BaseSubdermalImplant } de { ent-FreedomImplanter.suffix }
    .desc = Um implante que possui um dispositivo rastreador conectado à rede de monitoramento da tripulação.

ent-RadioImplant = { ent-BaseSubdermalImplant } de { ent-RadioImplanter.suffix }
    .desc = Um implante que permite acesso a frequência do Sindicato sem necessidade de fones de ouvido.

ent-UplinkImplant = { ent-BaseSubdermalImplant } { ent-UplinkImplanter.suffix }
    .desc = Um implante que permite ao usuário acesso a um uplink secreto quando quiser.

ent-EmpImplant = { ent-BaseSubdermalImplant } { ent-EmpImplanter.suffix }
    .desc = Um implante que cria um pulso eletromagnético quando ativo.
