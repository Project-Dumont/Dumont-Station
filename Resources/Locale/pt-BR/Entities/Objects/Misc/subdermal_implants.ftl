# Base
ent-BaseSubdermalImplant = implante
    .desc = Um biochip microscópico que é injetado por baixo da pele.

# Central de Comando
ent-RadioImplantCentcomm = { ent-BaseSubdermalImplant } de { ent-RadioImplanterCentcomm.suffix }
    .desc = Um implante que providencia acesso a frequência da Central de Comando  mesmo sem um fone de ouvido. Permitido somente para autorizados da Central de Comando.

ent-DeathRattleImplantCentcomm = { ent-BaseSubdermalImplant } { ent-DeathRattleImplanterCentcomm.suffix }
    .desc = Um implante que notificará na frequência da Central de Comando caso o usuário morra ou entre em estado crítico.

# Tripulação
# Diversão
ent-SadTromboneImplant = { ent-BaseSubdermalImplant } de { ent-SadTromboneImplanter.suffix }
    .desc = Um implante que toca uma música trágica quando o usuário morre.

ent-LightImplant = { ent-BaseSubdermalImplant } de { ent-LightImplanter.suffix }
    .desc = Um implante que emite uma luz da pele do usuário quando ativo.

ent-BikeHornImplant = { ent-BaseSubdermalImplant } de { ent-BikeHornImplanter.suffix }
    .desc = Um implante que permite ao usuário buzinar a qualquer momento e em qualquer lugar. Honk!

# Segurança
ent-TrackingImplant = { ent-BaseSubdermalImplant } { ent-TrackingImplanter.suffix }
    .desc = Um implante que possui um dispositivo rastreador conectado à rede de monitoramento da tripulação.

ent-MindShieldImplant = { ent-BaseSubdermalImplant } { ent-MindShieldImplanter.suffix }
    .desc = Um implante que garante lealdade à corporação ao proteger o usuário e previnir o funcionamento de dispositivos de controle mental.

# Antagonistas
ent-StorageImplant = { ent-BaseSubdermalImplant } de { ent-StorageImplanter.suffix }
    .desc = Um implante que permite ao usuário livrar-se de algemas ou amarras até três vezes antes de parar de funcionar.

ent-FreedomImplant = { ent-BaseSubdermalImplant } de { ent-FreedomImplanter.suffix }
    .desc = Um implante que possui um dispositivo rastreador conectado à rede de monitoramento da tripulação.

ent-RadioImplant = { ent-BaseSubdermalImplant } de { ent-RadioImplanter.suffix }
    .desc = Um implante que permite acesso a frequência do Sindicato sem necessidade de fones de ouvido.

ent-UplinkImplant = { ent-BaseSubdermalImplant } { ent-UplinkImplanter.suffix }
    .desc = Um implante que permite ao usuário acesso a um uplink secreto quando quiser.

ent-EmpImplant = { ent-BaseSubdermalImplant } de { ent-EmpImplanter.suffix }
    .desc = Um implante que cria um pulso eletromagnético quando ativo.

ent-ScramImplant = { ent-BaseSubdermalImplant } de { ent-ScramImplanter.suffix }
    .desc = Um implante que teletransporta o usuário aleatoriamente dentro de um grande raio quando usado. Possui carga suficiente para três usos.

ent-DnaScramblerImplant = { ent-BaseSubdermalImplant } { ent-DnaScramblerImplanter.suffix }
    .desc = Um implante capaz de aleatoriamente mudar a aparência e DNA do usuário uma vez de forma reversível.

ent-ChameleonControllerImplant = { ent-BaseSubdermalImplant } { ent-ChameleonControllerImplanter.suffix }
    .desc = Um implante que permite rapidamente mudar a aparência de todos os itens camaleão equipados.

ent-MicroBombImplant = { ent-BaseSubdermalImplant } { ent-MicroBombImplanter.suffix }
    .desc = Um implante que explode o usuário quando morto ou manualmente ativado.

ent-MacroBombImplant = { ent-BaseSubdermalImplant } { ent-MacroBombImplanter.suffix }
    .desc = Um implante que cria uma enorme explosão após um breve atraso quando o usuário morre.

ent-FakeMindShieldImplant = { ent-BaseSubdermalImplant } de { ent-FakeMindShieldImplanter.suffix }
    .desc = Um implante que permite ao usuário transmitir um sinal falso que as interfaces de segurança da NanoTrasen utilizam para verificar a presença de um implante de { ent-MindShieldImplanter.suffix }.

# Nukie
ent-HostageImplant = { ent-BaseSubdermalImplant } de { ent-HostageImplanter.suffix }
    .desc = Um implante perfeito para todas as operações de sequestro! Usuários serão ignorados pelo sistema de reconhecimento das torretas do Sindicato.

ent-DeathAcidifierImplant = { ent-BaseSubdermalImplant } { ent-DeathAcidifierImplanter.suffix }
    .desc = Um implante que derrete o usuário e seu equipamento após a morte.

ent-DeathRattleImplant = { ent-BaseSubdermalImplant } { ent-DeathRattleImplanter.suffix }
    .desc = Um implante que notificará na frequência do Sindicato caso o usuário morra ou entre em estado crítico.
