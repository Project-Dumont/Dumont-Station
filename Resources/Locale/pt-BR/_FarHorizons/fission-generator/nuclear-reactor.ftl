reactor-smoke-stop = O {$owner} para de soltar fumaça.
reactor-fire-start = O {$owner} começa a pegar fogo!
reactor-fire-stop = O {$owner} para de queimar.

reactor-unanchor-melted = Você não consegue desancorar o reator nuclear, ele derreteu e grudou no casco!
reactor-unanchor-warning = Você não consegue desancorar o reator nuclear enquanto ele não estiver vazio ou estiver acima de 80C!

### Messages
reactor-smoke-start-message = ALERTA: O {$owner} atingiu uma temperatura perigosa: {$temperature}K. Intervenham imediatamente para evitar o derretimento.
reactor-smoke-stop-message = O {$owner} esfriou abaixo da temperatura perigosa. Tenham um bom dia.
reactor-fire-start-message = ALERTA: O {$owner} atingiu temperatura CRÍTICA: {$temperature}K. DERRETIMENTO IMINENTE.
reactor-fire-stop-message = O {$owner} esfriou abaixo da temperatura crítica. Derretimento evitado.

reactor-temperature-dangerous-message = O {$owner} está em temperatura perigosa: {$temperature}K.
reactor-temperature-critical-message = O {$owner} está em temperatura crítica: {$temperature}K.
reactor-temperature-cooling-message = O {$owner} está esfriando: {$temperature}K.

reactor-melting-announcement = Um reator nuclear a bordo da estação está começando a derreter. Recomenda-se evacuar a área ao redor.
reactor-melting-announcement-sender = Emergência Nuclear

reactor-meltdown-announcement = Um reator nuclear a bordo da estação sofreu uma sobrecarga catastrófica. Detritos radioativos, precipitação nuclear e incêndios de refrigerante são prováveis. É fortemente recomendado evacuar imediatamente a área ao redor.
reactor-meltdown-announcement-sender = Derretimento Nuclear

