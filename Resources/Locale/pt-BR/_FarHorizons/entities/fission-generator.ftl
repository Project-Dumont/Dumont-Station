# Reator

ent-BaseNuclearReactor = reator nuclear
    .desc = Um vaso de reator nuclear, com encaixes para barras de combustível e outras peças. Peraí, um desses não explodiu uma vez?
ent-NuclearReactorMelted = reator nuclear
    .desc = Um vaso de reator nuclear quebrado. Ele brilha de calor e radiação.
ent-NuclearReactorSmall = reator nuclear pequeno
    .desc = { ent-BaseNuclearReactor.desc }
ent-NuclearReactorSmallMelted = reator nuclear pequeno
    .desc = Um vaso de reator nuclear quebrado. Ele brilha de calor e radiação.
ent-NuclearReactorMeltedSalvage = reator nuclear
    .desc = Um vaso de reator nuclear que derreteu faz tempo. Ainda brilha com o calor e a radiação que sobraram.
ent-NuclearReactorSmallSalvage = reator nuclear pequeno
    .desc = { ent-BaseNuclearReactor.desc }
ent-NuclearReactorSmallMeltedSalvage = reator nuclear pequeno
    .desc = Um vaso de reator nuclear que derreteu faz tempo. Ainda brilha com o calor e a radiação que sobraram.
ent-NuclearDebrisChunk = detritos nucleares
    .desc = Você não está vendo grafite no chão. Você está em choque. Vá para a enfermaria.

