<windows:CharacterWindow
    xmlns="https://spacestation14.io"
    xmlns:cc="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:windows="clr-namespace:Content.Client.UserInterface.Systems.Character.Windows"
    Title="{Loc 'character-info-title'}"
    MinSize="725 425"
    SetWidth="725"
    SetHeight="575">
    <!-- Dumont -->
    <BoxContainer Orientation="Horizontal" Margin="10 5 10 10">
        <ScrollContainer HScrollEnabled="False" SetWidth="250" Margin="5">
            <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                <Label Name="RoleType" HorizontalAlignment="Center" StyleClasses="LabelHeading" Access="Public"/>
                <Label Name="Organization" Access="Public" HorizontalAlignment="Center" StyleClasses="LabelHeading"/>
                <Label Name="AntagName" Access="Public" HorizontalAlignment="Center" StyleClasses="LabelHeading"/>
                <PanelContainer StyleClasses="LowDivider" Margin="0 5"/>
                <SpriteView OverrideDirection="South" Scale="4 4" Name="SpriteView" Access="Public" SetSize="128 128" HorizontalAlignment="Center" Margin="5 5 5 15"/>
                <Label Name="NameLabel" Access="Public" HorizontalAlignment="Center"/>
                <BoxContainer HorizontalAlignment="Center">
                    <TextureRect Name="JobIcon" Access="Public" TextureScale="2 2" VerticalAlignment="Center" Margin="0 0 5 0"/>
                    <Label Name="SubText" StyleClasses="LabelSubText" Access="Public" VerticalAlignment="Center"/>
                </BoxContainer>
                <Label Name="NanoBankAccount" StyleClasses="LabelSubText" Access="Public" HorizontalAlignment="Center"/>
            </BoxContainer>
        </ScrollContainer>
        <PanelContainer StyleClasses="LowDivider" Margin="5 0"/>
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="5">
            <Label Name="ObjectivesLabel" Access="Public" Text="{Loc 'character-info-objectives-label'}" StyleClasses="LabelHeading" Margin="0 0 0 5"/>
            <PanelContainer StyleClasses="PanelDark" HorizontalExpand="True" VerticalExpand="True">
                <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="10">
                        <BoxContainer Orientation="Vertical" Name="Objectives" Access="Public"/>
                        <cc:Placeholder Name="RolePlaceholder" Access="Public" PlaceholderText="{Loc 'character-info-roles-antagonist-text'}"/>
                    </BoxContainer>
                </ScrollContainer>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</windows:CharacterWindow>
