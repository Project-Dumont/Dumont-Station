<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               Title="{Loc 'triage-tagger-window-title'}"
               MinSize="380 0">
    <BoxContainer Orientation="Vertical" SeparationOverride="8">
        <Label Name="PatientLabel" StyleClasses="LabelHeading" />
        <BoxContainer Name="LevelsContainer" Orientation="Vertical" SeparationOverride="4" />
        <Button Name="ClearButton" Text="{Loc 'triage-tagger-clear'}" />
    </BoxContainer>
</DefaultWindow>
