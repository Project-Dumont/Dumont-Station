<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc 'niver-wish-window-title'}"
               MinSize="400 0">
    <BoxContainer Orientation="Vertical" SeparationOverride="8">
        <Label Text="{Loc 'niver-wish-window-text'}" StyleClasses="LabelHeading" HorizontalAlignment="Center" />
        <Label Name="TimerLabel" HorizontalAlignment="Center" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="8" HorizontalAlignment="Center">
            <Button Name="WishButton" Text="{Loc 'niver-wish-window-wish'}" />
            <Button Name="RefuseButton" Text="{Loc 'niver-wish-window-refuse'}" StyleClasses="Caution" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
