<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc 'canvas-window-title'}"
               Resizable="True"
               SetSize="700 700"
               MinSize="700 700">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Name="HeaderColorPreview" Orientation="Horizontal" Align="Center" Margin="0 8 0 8">
            <Label Text="{Loc 'canvas-window-colour-label'}" Margin="0 0 8 0"/>
            <Button Name="ColorPreview" Text="{Loc 'canvas-window-colour-preview'}" Margin="8 0 0 0" />
        </BoxContainer>
        <BoxContainer Name="HeaderTools" Orientation="Horizontal" Margin="0 0 0 8">
            <LineEdit Name="Search" PlaceHolder="{Loc 'canvas-window-paint-code-placeholder'}" HorizontalExpand="True" />
            <Button Name="ImportButton" Text="{Loc 'canvas-window-import-button'}" Margin="8 0 0 0" />
            <Button Name="ExportButton" Text="{Loc 'canvas-window-export-button'}" Margin="8 0 0 0" />
            <Button Name="FinalizeButton" Text="{Loc 'canvas-window-finalize-button'}" Margin="8 0 0 0" />
        </BoxContainer>
        <ScrollContainer VerticalExpand="True">

            <BoxContainer Orientation="Horizontal" Align="Begin">
                <BoxContainer Name="ResolutionContainer" Orientation="Vertical" Align="Begin">
                    <Label Text="{Loc 'canvas-window-resolution-label'}"/>
                    <BoxContainer Orientation="Horizontal">
                        <Slider Name="HeightSize"
                                MinValue="16"
                                MaxValue="32"
                                HorizontalExpand="True"
                                MinSize="80 0"
                                Rounded="True" />
                        <Control MinSize="8 0" />
                        <Label Name="HeightSizeLabel" Text="16" MinSize="48 0"/>
                        <Control MinSize="4 0"/>

                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal">
                        <Slider Name="WidthSize"
                                MinValue="16"
                                MaxValue="32"
                                HorizontalExpand="True"
                                MinSize="80 0"
                                Rounded="True" />
                        <Control MinSize="8 0" />
                        <Label Name="WidthSizeLabel" Text="16" MinSize="48 0"/>
                        <Control MinSize="4 0"/>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" Align="Center">
                        <LineEdit Name="ArtistSignature" PlaceHolder="{Loc 'canvas-window-signature-placeholder'}" HorizontalExpand="True" />
                    </BoxContainer>
                    <BoxContainer Name="ColorSelector" Orientation="Horizontal" Align="Center">
                    </BoxContainer>
                </BoxContainer>
                <GridContainer Name="Grids" HorizontalAlignment="Center" VerticalExpand="True">
                </GridContainer>
            </BoxContainer>

        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
