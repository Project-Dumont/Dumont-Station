<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:adt="clr-namespace:Content.Client.ADT.Shuttles"
    Title="{Loc drop-pod-console-title}"
    MinSize="680 420"
    Resizable="False">

    <BoxContainer Orientation="Horizontal" Margin="8">

        <BoxContainer
            Orientation="Vertical"
            MinWidth="220"
            Margin="0 0 10 0">

            <Label Name="StatusLabel" Margin="0 0 0 4"/>

            <Label Name="TcLabel" Margin="0 0 0 8"/>

            <Label Name="WarStatusLabel" Margin="0 0 0 8"/>

            <Label
                Text="{Loc drop-pod-console-beacon-list-header}"
                FontColorOverride="#AAAAAA"
                Margin="0 0 0 4"/>

            <ScrollContainer
                VerticalExpand="True"
                HorizontalExpand="True"
                Margin="0 0 0 8">

                <BoxContainer
                    Name="BeaconList"
                    Orientation="Vertical"/>

            </ScrollContainer>

            <customControls:HSeparator Margin="0 0 0 6"/>

            <Label
                Text="{Loc drop-pod-console-selected-header}"
                FontColorOverride="#AAAAAA"
                Margin="0 0 0 2"/>

            <Label
                Name="SelectedLabel"
                Margin="0 0 0 8"/>

            <customControls:HSeparator Margin="0 0 0 6"/>

            <Label
                Text="{Loc drop-pod-console-notice}"
                FontColorOverride="#DDAA00"
                HorizontalExpand="True"
                Margin="0 0 0 8"/>

            <Button
                Name="DeployButton"
                Text="{Loc drop-pod-console-deploy-button}"
                HorizontalExpand="True"/>

        </BoxContainer>

        <adt:DropPodNavMapControl
            Name="MapControl"
            SetWidth="420"
            SetHeight="370"
            RectClipContent="True"/>

    </BoxContainer>

</controls:FancyWindow>