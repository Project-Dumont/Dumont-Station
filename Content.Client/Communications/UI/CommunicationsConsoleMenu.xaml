<controls:FancyWindow xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    Title="{Loc 'comms-console-menu-title'}"
    MinSize="300 300">

    <BoxContainer Orientation="Vertical"  MaxWidth="800">
        <BoxContainer Name="StationActions" Orientation="Horizontal" MinHeight="190">
            <BoxContainer Name="AnnouncementArea" Orientation="Vertical" Margin="15">
                <TextEdit Name="MessageInput" VerticalExpand="True"/>
                <BoxContainer Orientation="Horizontal">
                    <Button Name="AnnounceButton"
                            Access="Public"
                            Text="{Loc 'comms-console-menu-announcement-button'}"
                            ToolTip="{Loc 'comms-console-menu-announcement-button-tooltip'}"
                            StyleClasses="OpenRight"
                            Margin="0 0 1 0"
                            Disabled="True"/>

                    <Button Name="BroadcastButton"
                            Access="Public"
                            Text="{Loc 'comms-console-menu-broadcast-button'}"
                            ToolTip="{Loc 'comms-console-menu-broadcast-button-tooltip'}"
                            StyleClasses="OpenBoth"/>

                    <Button Name="CentCommButton"
                            Text="{Loc 'comms-console-menu-message-centcomm'}"
                            Access="Public"
                            StyleClasses="OpenLeft"/>
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Name="EmergencyArea" Orientation="Vertical" Margin="15">
                <Button Name="EmergencyShuttleButton"
                    Access="Public"
                    Text="Call Evacuation Shuttle"
                    ToolTip="{Loc 'comms-console-menu-emergency-shuttle-button-tooltip'}"
                    StyleClasses="OpenLeft"
                    VerticalExpand="True"
                    />

                <Button Name="MartialButton"
                    Text="{Loc 'comms-console-menu-martial'}"
                    ToolTip="{Loc 'comms-console-menu-martial-help'}"
                    StyleClasses="OpenBoth"
                    Access="Public"
                    VerticalExpand="True"
                    />

                <Button Name="MaintEmergencyButton"
                    Text="{Loc 'comms-console-menu-emergency-maint'}"
                    StyleClasses="OpenRight"
                    Access="Public"
                    VerticalExpand="True"
                    />
            </BoxContainer>

        </BoxContainer>
        <BoxContainer Name="AlertLevelArea" Orientation="Horizontal" Margin="20" MinHeight="70" HorizontalAlignment="Center">
            <Button Name="GreenAlertButton"
                Text="{Loc 'comms-console-menu-green-alert'}"
                Access="Public"
                Margin="10"
                MaxWidth="120"
                ToolTip="{Loc 'comms-console-menu-green-alert'}"
                StyleClasses="LabelKeyText">

            </Button>
            <Button Name="BlueAlertButton"
                Text="{Loc 'comms-console-menu-blue-alert'}"
                Access="Public"
                Margin="10"
                MaxWidth="120"
                ToolTip="{Loc 'comms-console-menu-blue-alert'}"
                StyleClasses="LabelKeyText">
            </Button>
            <Button Name="YellowAlertButton"
                Text="{Loc 'comms-console-menu-yellow-alert'}"
                Access="Public"
                Margin="10"
                MaxWidth="120"
                ToolTip="{Loc 'comms-console-menu-yellow-alert'}"
                StyleClasses="LabelKeyText">
            </Button>
            <Button Name="RedAlertButton"
                Text="{Loc 'comms-console-menu-red-alert'}"
                Access="Public"
                Margin="10"
                MaxWidth="120"
                ToolTip="{Loc 'comms-console-menu-red-alert'}"
                StyleClasses="LabelKeyText">
            </Button>
            <Button Name="VioletAlertButton"
                Text="{Loc 'comms-console-menu-violet-alert'}"
                Access="Public"
                Margin="10"
                MaxWidth="120"
                ToolTip="{Loc 'comms-console-menu-violet-alert'}"
                StyleClasses="LabelKeyText">
            </Button>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
